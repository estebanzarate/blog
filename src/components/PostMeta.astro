---
import { Image } from "astro:assets";

const { post } = Astro.props;
const data = post.data;

const platformMap: any = {
    dockerlabs: {
        label: "DockerLabs",
        class: "dockerlabs",
    },
    hackthebox: {
        label: "Hack The Box",
        class: "htb",
    },
};

const difficultyMap: any = {
    muyfacil: {
        label: "Muy Fácil",
        class: "muy-facil",
    },
    veryeasy: {
        label: "Very Easy",
        class: "very-easy",
    },
    easy: {
        label: "Easy",
        class: "easy",
    },
    medium: {
        label: "Medium",
        class: "medium",
    },
    hard: {
        label: "Hard",
        class: "hard",
    },
    insane: {
        label: "Insane",
        class: "insane",
    },
};

const osMap: any = {
    linux: {
        label: "Linux",
        class: "linux",
    },
    windows: {
        label: "Windows",
        class: "windows",
    },
};

const platform = data.platform && platformMap[data.platform];
const difficulty = data.difficulty && difficultyMap[data.difficulty];
const os = data.os && osMap[data.os];
---

{
    (platform || difficulty || os) && (
        <div class="post-meta">
            <strong>- - -</strong>
            {platform && (
                <p>
                    <strong>Plataforma:</strong>
                    <span class={`badge ${platform.class}`}>
                        {platform.label}
                    </span>
                </p>
            )}

            {os && (
                <p>
                    <strong>OS:</strong>
                    <span class={`badge ${os.class}`}>{os.label}</span>
                </p>
            )}

            {difficulty && (
                <p>
                    <strong>Dificultad:</strong>
                    <span class={`badge ${difficulty.class}`}>
                        {difficulty.label}
                    </span>
                </p>
            )}
            {data.url && (
                <p>
                    <strong>Url:</strong>
                    <a
                        class="badge badge-url"
                        href={data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {data.url}
                    </a>
                </p>
            )}
            <strong>- - -</strong>
        </div>
    )
}
{
    data.image && (
        <div class="image-container">
            <Image
                src={data.image.src}
                alt={data.title}
                width={280}
                height={200}
                loading="lazy"
                class="image"
                data-no-zoom
            />
        </div>
    )
}

<style>
    .post-meta {
        margin: 1.5rem 0 2rem;
        p {
            margin: 0;
            strong {
                margin-right: 0.5rem;
            }
        }
    }

    .badge {
        display: inline-flex;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-secondary);
    }

    .badge-url {
        color: var(--text-accent);
    }
    .dockerlabs {
        border-color: var(--color-primary);
    }
    .htb {
        border-color: var(--color-success);
    }

    .linux {
    }

    .windows {
    }
    .muy-facil {
    }
    .very-easy {
    }

    .easy {
    }

    .medium {
    }

    .hard {
    }

    .insane {
    }
    .image-container {
        display: flex;
        justify-content: center;
        margin-bottom: 1rem;
        .image {
            width: 100%;
            max-width: 250px;
            height: auto;
        }
    }
    .url-container {
        display: flex;
        justify-content: center;
        a {
            font-size: clamp(1rem, 5vw, 1.2rem);
            text-decoration: none;
            line-break: anywhere;
        }
    }
</style>
