---
const { post } = Astro.props;
const data = post.data;

const platformMap: any = {
    hackthebox: {
        label: "Hack The Box",
        class: "htb",
    },
};

const difficultyMap: any = {
    veryeasy: {
        label: "Very Easy",
        class: "very-easy",
    },
    easy: {
        label: "Easy",
        class: "easy",
    },
    medium: {
        label: "Medium",
        class: "medium",
    },
    hard: {
        label: "Hard",
        class: "hard",
    },
    insane: {
        label: "Insane",
        class: "insane",
    },
};

const osMap: any = {
    linux: {
        label: "Linux",
        class: "linux",
    },
    windows: {
        label: "Windows",
        class: "windows",
    },
};

const platform = data.platform && platformMap[data.platform];
const difficulty = data.difficulty && difficultyMap[data.difficulty];
const os = data.os && osMap[data.os];
---

{
    (platform || difficulty || os) && (
        <div class="post-meta">
            <strong>- - -</strong>
            {platform && (
                <p>
                    <strong>Plataforma:</strong>
                    <span class={`badge ${platform.class}`}>
                        {platform.label}
                    </span>
                </p>
            )}

            {os && (
                <p>
                    <strong>OS:</strong>
                    <span class={`badge ${os.class}`}>{os.label}</span>
                </p>
            )}

            {difficulty && (
                <p>
                    <strong>Dificultad:</strong>
                    <span class={`badge ${difficulty.class}`}>
                        {difficulty.label}
                    </span>
                </p>
            )}
            <strong>- - -</strong>
        </div>
    )
}

<style>
    .post-meta {
        margin: 1.5rem 0 2rem;
        p {
            margin: 0;
            strong {
                margin-right: 0.5rem;
            }
        }
    }

    .badge {
        display: inline-flex;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
        border: 1px solid var(--border-default);
        background: var(--bg-surface-alt);
        color: var(--text-secondary);
    }

    .htb {
        border-color: var(--color-success);
    }

    .linux {
    }

    .windows {
    }

    .very-easy {
    }

    .easy {
    }

    .medium {
    }

    .hard {
    }

    .insane {
    }
</style>
