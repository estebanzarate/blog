---
interface Props {
	showToc?: boolean;
}
const { showToc = false } = Astro.props;
---

<header class="main-header">
	<button id="open-tree" class="tree-toggle" aria-label="Abrir menú">
		<svg
			width="20"
			height="20"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
		>
			<line x1="3" y1="6" x2="21" y2="6"></line>
			<line x1="3" y1="12" x2="21" y2="12"></line>
			<line x1="3" y1="18" x2="21" y2="18"></line>
		</svg>
	</button>
	<a href="/">
		<span class="emoji">😐</span>
		<h1 class="brandname">
			<span>[</span> no<span style="color: var(--text-color-02);">Ø</span
			>funny <span>]</span>
		</h1>
	</a>
	<div>
		<div class="social-media-container">
			<a
				href="https://www.linkedin.com/in/esteban-zarate"
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="1em"
					height="1em"
					viewBox="0 0 24 24"
					><title>LinkedIn</title><path
						fill="currentColor"
						d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z"
					></path></svg
				>
			</a>
			<a
				href="https://github.com/estebanzarate"
				target="_blank"
				rel="noopener noreferrer"
				><svg
					xmlns="http://www.w3.org/2000/svg"
					width="1em"
					height="1em"
					viewBox="0 0 24 24"
					><title>Github</title><path
						fill="currentColor"
						d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
					></path></svg
				>
			</a>
			<a
				href="https://app.hackthebox.com/users/1089152"
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="1em"
					height="1em"
					viewBox="0 0 24 24"
					><title>Hack The Box</title><path
						fill="currentColor"
						d="m22.51 6.457l.001-.013a.9.9 0 0 0-.271-.638l-.027-.024q-.028-.025-.057-.048q-.03-.022-.06-.04l-.029-.02l-9.61-5.547a.89.89 0 0 0-.922.004L1.933 5.674l-.03.02l-.023.014l-.02.015a1 1 0 0 0-.147.134l-.003.003a.9.9 0 0 0-.221.584v.014l-.001.027v11.07c0 .328.18.63.469.784l9.599 5.542l.023.011a1 1 0 0 0 .166.07l.04.01l.072.015l.035.006a.8.8 0 0 0 .216 0q.018-.002.035-.006l.072-.014l.04-.012l.064-.022a1 1 0 0 0 .102-.047l.023-.011l9.599-5.542a.89.89 0 0 0 .469-.784V6.478zM5.255 6.082l6.537-3.774a.42.42 0 0 1 .418 0l6.537 3.774a.418.418 0 0 1 0 .725l-6.537 3.774a.42.42 0 0 1-.418 0L5.254 6.807a.418.418 0 0 1 0-.725m5.614 14.345a.417.417 0 0 1-.626.361l-6.524-3.766a.42.42 0 0 1-.209-.361V9.127a.417.417 0 0 1 .626-.361l6.524 3.766a.42.42 0 0 1 .209.362zm9.623-3.766a.42.42 0 0 1-.209.36l-6.524 3.767a.417.417 0 0 1-.626-.36v-7.533c0-.15.08-.287.209-.362l6.524-3.766a.417.417 0 0 1 .626.36z"
					></path></svg
				>
			</a>
		</div>
		{
			showToc && (
				<button
					id="open-index"
					class="index-toggle"
					aria-label="Abrir índice"
				>
					<svg
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
					>
						<line x1="4" y1="6" x2="20" y2="6" />
						<line x1="4" y1="12" x2="20" y2="12" />
						<line x1="4" y1="18" x2="14" y2="18" />
					</svg>
				</button>
			)
		}
	</div>
</header>

<script>
	const nav = document.querySelector<HTMLElement>(".main-header");

	function setNavHeight() {
		if (!nav) return;
		const height = nav.offsetHeight;
		document.documentElement.style.setProperty(
			"--nav-offset",
			`${height}px`,
		);
	}

	setNavHeight();

	if (nav) {
		const resizeObserver = new ResizeObserver(setNavHeight);
		resizeObserver.observe(nav);
	}
</script>

<style>
	.main-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 200;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem;
		background: var(--bg-color);
		backdrop-filter: blur(12px);
		.index-toggle {
			display: flex;
			align-items: center;
			justify-content: center;
			border: none;
			padding: 0.4rem;
			background: unset;
			color: var(--text-accent, currentColor);
			cursor: pointer;
		}
		.index-toggle:hover {
			border-radius: 4px;
			background-color: var(--bg-color-hover);
		}
		a {
			display: flex;
			align-items: center;
			column-gap: 0.25rem;
			h1 {
				display: none;
			}
			@media screen and (min-width: 480px) {
				h1 {
					display: flex;
					align-items: center;
					column-gap: 0.25rem;
					margin: 0;
					font-size: clamp(1rem, 5vw, 1.75rem);
					span {
						color: var(--text-accent);
					}
				}
			}
			.emoji {
				margin-right: 0.25rem;
				font-size: clamp(1rem, 5vw, 1.75rem);
			}
		}
		div {
			display: flex;
			align-items: center;
			.social-media-container {
				display: flex;
				align-items: center;
				a {
					display: flex;
					padding: 0.25rem;
					&:hover {
						border-radius: 4px;
						background-color: var(--bg-color-hover);
					}
					svg {
						width: 1.5rem;
						height: 1.5rem;
					}
					&:nth-of-type(1) svg {
						color: var(--color-primary);
					}
					&:nth-of-type(2) svg {
						color: var(--color-secondary);
					}
					&:nth-of-type(3) svg {
						color: var(--color-accent);
					}
				}
			}
			button {
				border: none;
				padding: 0.25rem;
				background-color: unset;
				font-size: 1rem;
				line-height: 1rem;
				&:hover {
					cursor: pointer;
				}
			}
		}
	}

	.tree-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		border: none;
		padding: 0.4rem;
		background: unset;
		color: var(--text-color-05);
		cursor: pointer;
	}
	.tree-toggle:hover {
		border-radius: 4px;
		background-color: var(--bg-color-hover);
	}

	@media (max-width: 1024px) {
		.tree-toggle {
			display: flex;
		}
	}
</style>
