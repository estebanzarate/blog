---
import { Font } from "astro:assets";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import PostTree from "@components/PostTree.astro";
import Head from "@components/Head.astro";
import "@styles/global.css";

interface Props {
	showToc?: boolean;
	showTree?: boolean;
	title?: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
}
const {
	showToc = false,
	showTree = false,
	title,
	description,
	image,
	type,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<Head
			title={title}
			description={description}
			image={image}
			type={type}
		/>
		<Font cssVariable="--font-jost" />
		<Font cssVariable="--font-dejavu" />
	</head>
	<body>
		<Navbar showToc={showToc} />
		<div class="app-shell">
			{showTree && <PostTree />}
			<main>
				<slot />
			</main>
		</div>
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
	.app-shell {
		display: flex;
		gap: 1rem;
	}
	main {
		flex: 1;
		min-width: 0;
		padding-inline: 1rem;
	}
</style>
