---
import Layout from "@layouts/Layout.astro";
---

<Layout>
    <div class="error-page">
        <p class="error-code">404</p>
        <h1>Página no encontrada</h1>
        <p class="error-message">
            <code>curl: (22) The requested URL returned error: 404</code>
        </p>
        <p class="error-hint">
            Parece que esta ruta no existe, o alguien la movió sin avisar.
        </p>
        <a href="/es/" class="home-link">Volver al inicio</a>
    </div>
</Layout>

<style>
    .error-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-height: 60vh;
        padding: 2rem 1rem;
        gap: 0.75rem;
    }
    .error-code {
        margin: 0;
        font-family: var(--font-sans);
        font-size: clamp(4rem, 15vw, 7rem);
        font-weight: 700;
        line-height: 1;
        color: var(--text-accent);
    }
    h1 {
        margin: 0;
        font-size: clamp(1.25rem, 4vw, 1.75rem);
        color: var(--text-color-01);
    }
    .error-message {
        margin: 0.5rem 0 0;
        padding: 0.6rem 1rem;
        background-color: var(--bg-color-02);
        border: 1px solid var(--bg-color-border-01);
        border-radius: 6px;
        font-family: var(--font-sans);
        font-size: 0.9rem;
        color: var(--text-color-02);
    }
    .error-hint {
        margin: 0;
        color: var(--text-color-05);
        font-size: 0.95rem;
    }
    .home-link {
        margin-top: 1rem;
        padding: 0.6rem 1.5rem;
        background-color: var(--bg-color-03);
        color: var(--text-color-01);
        text-decoration: none;
        font-weight: 500;
        border-radius: 6px;
        transition:
            background-color 0.15s ease,
            color 0.15s ease;
    }
    .home-link:hover {
        background-color: var(--bg-color-hover);
        color: var(--text-accent);
    }
</style>
