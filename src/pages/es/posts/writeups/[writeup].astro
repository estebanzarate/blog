---
import PostLayout from "@layouts/PostLayout.astro";
import { getCollection, render } from "astro:content";
import Callout from "@components/Callout.astro";

export async function getStaticPaths() {
    const writeups = await getCollection("writeup");
    return writeups.map((writeup) => ({
        params: {
            writeup: writeup.id,
        },
        props: {
            writeup,
        },
    }));
}

const { writeup } = Astro.props;
const { Content, headings } = await render(writeup);
---

<PostLayout {headings}>
    <h1>{writeup.data.title}</h1>
    <p>{writeup.data.description}</p>
    <div>
        <Content components={{ Callout }} />
    </div>
</PostLayout>
