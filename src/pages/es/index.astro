---
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
const lang = Astro.currentLocale ?? "es";
const posts = await getCollection("post");
const filteredPosts = posts.filter(
	(post) =>
		post.data.draft != true &&
		post.data.featured === true &&
		post.data.lang === lang,
);

const platformMap: any = {
	overthewire: {
		label: "OverTheWire",
		class: "overthewire",
	},
	dockerlabs: {
		label: "DockerLabs",
		class: "dockerlabs",
	},
	hackthebox: {
		label: "Hack The Box",
		class: "htb",
	},
};

const difficultyMap: any = {
	muyfacil: {
		label: "Muy Fácil",
		class: "muy-facil",
	},
	veryeasy: {
		label: "Very Easy",
		class: "very-easy",
	},
	easy: {
		label: "Easy",
		class: "easy",
	},
	medium: {
		label: "Medium",
		class: "medium",
	},
	hard: {
		label: "Hard",
		class: "hard",
	},
	insane: {
		label: "Insane",
		class: "insane",
	},
};

const osMap: any = {
	linux: {
		label: "Linux",
		class: "linux",
	},
	windows: {
		label: "Windows",
		class: "windows",
	},
};
---

<Layout showTree={true}>
	<div class="cards">
		{
			filteredPosts.map((post) => {
				const platform =
					post.data.platform && platformMap[post.data.platform];

				const difficulty =
					post.data.difficulty && difficultyMap[post.data.difficulty];

				const os = post.data.os && osMap[post.data.os];

				return (
					<article class="card">
						<div>
							<h2>{post.data.title}</h2>

							{
								<>
									{post.data.image && (
										<div class="card-image-container">
											<Image
												src={post.data.image}
												alt={post.data.title}
												width={280}
												height={200}
												loading="lazy"
												class="card-image"
												data-no-zoom
											/>
										</div>
									)}
									{post.data.type === "writeup" && (
										<div class="card-meta">
											{platform && (
												<p
													class={`badge ${platform.class}`}
												>
													{platform.label}
												</p>
											)}
											<div class="card-meta-osdifficulty">
												{os && (
													<span
														class={`badge ${os.class}`}
													>
														{os.label}
													</span>
												)}
												{os && difficulty && "#"}
												{difficulty && (
													<span
														class={`badge ${difficulty.class}`}
													>
														{difficulty.label}
													</span>
												)}
											</div>
										</div>
									)}
								</>
							}

							{post.data.type === "post" &&
								post.data.description && (
									<p class="card-description">
										{post.data.description}
									</p>
								)}
						</div>

						<a class="card-link" href={`/es/${post.id}`}>
							Leer{" "}
							{post.data.type === "post" ? "post" : "writeup"}
						</a>
					</article>
				);
			})
		}
	</div>
</Layout>

<style>
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 250px));
		justify-content: center;
		gap: 1rem;
		max-width: 1200px;
		margin-top: 5rem;
		margin-inline: auto;
		@media screen and (min-width: 1000px) {
			justify-content: start;
		}
	}

	.card {
		display: flex;
		flex-direction: column;
		background-color: var(--bg-color-02);
		div {
			padding: 0.75rem 1rem;
			h2 {
				margin-block: 0.5rem 1rem;
				font-size: clamp(1.2rem, 5vw, 1.3rem);
			}
			.card-image-container {
				display: flex;
				justify-content: center;
				.card-image {
					width: 100%;
					max-width: 150px;
					height: auto;
				}
			}
			.card-meta {
				display: flex;
				flex-direction: column;
				align-items: center;
				row-gap: 0.25rem;
				padding: 0;
				.card-meta-osdifficulty {
					width: 100%;
					display: flex;
					justify-content: center;
					padding: 0;
				}
				.badge {
					margin: 0;
					padding: 0.1rem 0.4rem;
					font-size: 0.9rem;
					text-align: center;
				}
				.dockerlabs {
					border-color: var(--color-primary);
				}
				.htb {
					color: var(--color-success);
				}
				.linux {
				}

				.windows {
				}
				.muy-facil {
				}

				.very-easy {
				}

				.easy {
				}

				.medium {
					color: var(--color-warning-light);
				}

				.hard {
				}

				.insane {
				}
			}

			.card-description {
				line-height: 1.6rem;
				font-size: 0.9rem;
			}
		}
		.card-link {
			display: flex;
			justify-content: center;
			margin-top: auto;
			padding: 0.75rem 0.6rem;
			background-color: var(--bg-color-03);
			font-weight: 500;
			text-transform: uppercase;
			color: var(--text-color-02);
			text-decoration: none;
			transition: transform 0.2s;
			&:hover {
				background-color: var(--bg-color-hover);
			}
		}
	}
</style>
