---
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
const posts = await getCollection("post");
const filteredPosts = posts.filter((writeup) => writeup.data.draft != true);

const platformMap: any = {
	hackthebox: {
		label: "Hack The Box",
		class: "htb",
	},
};

const difficultyMap: any = {
	veryeasy: {
		label: "Very Easy",
		class: "very-easy",
	},
	easy: {
		label: "Easy",
		class: "easy",
	},
	medium: {
		label: "Medium",
		class: "medium",
	},
	hard: {
		label: "Hard",
		class: "hard",
	},
	insane: {
		label: "Insane",
		class: "insane",
	},
};

const osMap: any = {
	linux: {
		label: "Linux",
		class: "linux",
	},
	windows: {
		label: "Windows",
		class: "windows",
	},
};
---

<Layout>
	<div class="cards">
		{
			filteredPosts.map((post) => {
				const platform =
					post.data.platform && platformMap[post.data.platform];

				const difficulty =
					post.data.difficulty && difficultyMap[post.data.difficulty];

				const os = post.data.os && osMap[post.data.os];

				return (
					<article class="card">
						<h2>{post.data.title}</h2>

						{
							<>
								{post.data.image && (
									<div class="card-image-container">
										<Image
											src={post.data.image}
											alt={post.data.title}
											width={280}
											height={200}
											loading="lazy"
											class="card-image"
											data-no-zoom
										/>
									</div>
								)}

								<div class="card-meta">
									{platform && (
										<p class={`badge ${platform.class}`}>
											{platform.label}
										</p>
									)}

									{os && (
										<p class={`badge ${os.class}`}>
											{os.label}
										</p>
									)}

									{difficulty && (
										<p class={`badge ${difficulty.class}`}>
											{difficulty.label}
										</p>
									)}
								</div>
							</>
						}

						{post.data.description && (
							<p>{post.data.description}</p>
						)}

						<a class="card-link" href={`/es/${post.id}`}>
							Leer{" "}
							{post.data.type === "post" ? "post" : "writeup"}
						</a>
					</article>
				);
			})
		}
	</div>
</Layout>

<style>
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 250px));
		gap: 1rem;
		justify-content: center;
		margin-top: 5rem;
	}

	.card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--color-secondary-light);
		border-radius: 4px;
		padding: 0.75rem 1rem;
		&:hover {
			border: 1px solid var(--color-secondary);
		}
		h2 {
			margin-block: 0.5rem 1rem;
			font-size: clamp(1.2rem, 5vw, 1.3rem);
		}
		.card-image-container {
			display: flex;
			justify-content: center;
			margin-bottom: 1rem;
			.card-image {
				width: 100%;
				max-width: 150px;
				height: auto;
			}
		}
		.card-meta {
			display: flex;
			flex-direction: column;
			align-items: center;
			row-gap: 0.25rem;
			margin-bottom: 1rem;
			.badge {
				margin: 0;
				border: 1px solid var(--color-secondary-light);
				border-radius: 4px;
				padding: 0.1rem 0.4rem;
				font-size: 0.9rem;
				text-align: center;
			}
			.htb {
				color: var(--color-success);
			}

			.linux {
			}

			.windows {
			}

			.very-easy {
			}

			.easy {
			}

			.medium {
				color: var(--color-warning-light);
			}

			.hard {
			}

			.insane {
			}
		}
		.card-link {
			display: flex;
			justify-content: center;
			margin-top: auto;
			border: 2px solid var(--color-warning);
			padding: 0.4rem 0.6rem;
			background-color: #0d1117;
			color: var(--color-light);
			text-decoration: none;
			&:active {
				transform: scale(0.95);
			}
		}
	}
</style>
